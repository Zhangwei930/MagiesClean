{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口最小权限：只允许文件选择对话框与窗口控制。文件访问一律经由后端命令，WebView 不具备任意文件系统访问权限。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "dialog:allow-open"
  ]
}
